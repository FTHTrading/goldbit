datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum IntentStatus {
  PENDING
  SETTLED
  EXECUTED
  MINTED
  EXPIRED
  FAILED
  UNDERPAID
}

enum RedemptionStatus {
  LOCKED
  DISPATCHED
  COMPLETED
  REJECTED
}

model PaymentIntent {
  id                    String            @id @default(uuid())
  userId                String            @map("user_id")
  amountUsd             Decimal           @map("amount_usd") @db.Decimal(18, 6)
  targetWeightMg        Decimal           @map("target_weight_mg") @db.Decimal(24, 6)
  spotPriceLocked       Decimal           @map("spot_price_locked") @db.Decimal(18, 6)
  effectivePricePerGram Decimal           @map("effective_price_per_gram") @db.Decimal(18, 6)
  quoteExpiresAt        DateTime          @map("quote_expires_at")
  status                IntentStatus      @default(PENDING)
  depositAddress        String            @map("deposit_address")
  depositCoin           String            @default("pusdc") @map("deposit_coin")
  depositValueReceived  Decimal?          @map("deposit_value_received") @db.Decimal(18, 6)
  recipientXrplAddress  String            @map("recipient_xrpl_address")
  xrplTxHash            String?           @map("xrpl_tx_hash")
  createdAt             DateTime          @default(now()) @map("created_at")
  updatedAt             DateTime          @updatedAt @map("updated_at")

  wholesaleOrder        WholesaleOrder?
  vaultAllocations      VaultAllocation[]

  @@index([status])
  @@index([depositAddress])
  @@index([quoteExpiresAt])
  @@map("payment_intents")
}

model WholesaleOrder {
  id                String         @id @default(uuid())
  paymentIntentId   String         @unique @map("payment_intent_id")
  quoteId           String         @map("quote_id")
  orderId           String         @unique @map("order_id")
  status            String         @map("status")
  dealerSpreadUsd   Decimal        @map("dealer_spread_usd") @db.Decimal(18, 6)
  unykornFeeUsd     Decimal        @map("unykorn_fee_usd") @db.Decimal(18, 6)
  allocatedWeightMg Decimal        @map("allocated_weight_mg") @db.Decimal(24, 6)
  createdAt         DateTime       @default(now()) @map("created_at")

  paymentIntent     PaymentIntent  @relation(fields: [paymentIntentId], references: [id])

  @@map("wholesale_orders")
}

model VaultAllocation {
  id               String         @id @default(uuid())
  paymentIntentId  String?        @map("payment_intent_id")
  depository       String         @map("depository")
  subpoolId        String         @map("subpool_id")
  barSerialMasked  String         @map("bar_serial_masked")
  grossWeightGrams Decimal        @map("gross_weight_grams") @db.Decimal(24, 6)
  purity           Decimal        @map("purity") @db.Decimal(8, 6)
  fineWeightMg     Decimal        @map("fine_weight_mg") @db.Decimal(24, 6)
  receiptId        String         @unique @map("receipt_id")
  createdAt        DateTime       @default(now()) @map("created_at")

  paymentIntent    PaymentIntent? @relation(fields: [paymentIntentId], references: [id])

  @@index([subpoolId])
  @@index([receiptId])
  @@map("vault_allocations")
}

model ReconciliationAudit {
  id                String    @id @default(uuid())
  timestamp         DateTime  @default(now()) @map("timestamp")
  vaultFineMg       Decimal   @map("vault_fine_mg") @db.Decimal(24, 6)
  xrplCirculatingMg Decimal   @map("xrpl_circulating_mg") @db.Decimal(24, 6)
  pendingMintsMg    Decimal   @default(0) @map("pending_mints_mg") @db.Decimal(24, 6)
  pendingBurnsMg    Decimal   @default(0) @map("pending_burns_mg") @db.Decimal(24, 6)
  deltaSurplusMg    Decimal   @map("delta_surplus_mg") @db.Decimal(24, 6)
  isPassed          Boolean   @map("is_passed")
  attestationSigHex String?   @map("attestation_sig_hex")
  failureReason     String?   @map("failure_reason")
  createdAt         DateTime  @default(now()) @map("created_at")

  @@index([timestamp])
  @@index([isPassed])
  @@map("reconciliation_audits")
}

model SystemControl {
  id             String    @id @default("SYSTEM_DEFAULT")
  mintLocked     Boolean   @default(false) @map("mint_locked")
  lockReason     String?   @map("lock_reason")
  lastEvaluatedAt DateTime @default(now()) @map("last_evaluated_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@map("system_controls")
}

model RedemptionRequest {
  id                    String            @id @default(uuid())
  userId                String            @map("user_id")
  requestedWeightMg     Decimal           @map("requested_weight_mg") @db.Decimal(24, 6)
  xrplBurnTxHash        String            @unique @map("xrpl_burn_tx_hash")
  status                RedemptionStatus  @default(LOCKED)
  carrierTrackingNumber String?           @map("carrier_tracking_number")
  depositoryReleaseId   String?           @map("depository_release_id")
  createdAt             DateTime          @default(now()) @map("created_at")
  updatedAt             DateTime          @updatedAt @map("updated_at")

  @@index([userId])
  @@index([status])
  @@map("redemption_requests")
}
