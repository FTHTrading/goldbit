# Environment Configuration
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Database & Cache
DATABASE_URL=postgresql://unykorn_admin:unykorn_dev_password@localhost:5432/unykorn_gold_db?schema=public
REDIS_URL=redis://localhost:6379

# BitGo Enterprise Integration
BITGO_ENTERPRISE_WEBHOOK_SECRET=replace_with_bitgo_hmac_webhook_secret_32_bytes
BITGO_USDC_DEPOSIT_WALLET_ID=65b98f1234abcd567890ef12
BITGO_MIN_CONFIRMATION_DEPTH=64

# XRPL Rails Configuration
XRPL_RPC_URL=wss://s.altnet.rippletest.net:51233
XRPL_COLD_ISSUER_ADDRESS=rJLMSTy77hTxqgDw9WMxCnYC8m5vhqN3FQ
XRPL_HOT_ISSUER_SECRET=sEdVxxxxxxxxxxxxxxxxxxxxxxxxxxxx
XRPL_HOT_ISSUER_ADDRESS=rNX4faQ35SdtE4rDoEg8YeVLQKQ57AYyCt
XRPL_ASSET_CODE_HEX=5841555F4D470000000000000000000000000000
XRPL_ASSET_CODE_TEXT=XAU_MG

# Bullion / Wholesale Partner API
WHOLESALE_API_URL=https://api.sandbox.bulliondesk.com/v1
WHOLESALE_API_KEY=mock_apmex_wholesale_api_key
WHOLESALE_CLIENT_ACCOUNT_ID=SPV_WY_HOLDINGS_01
UNYKORN_TECH_FEE_USD=1.50
WHOLESALE_PREMIUM_BPS=75

# Proof-of-Reserve & Attestation
POR_HMAC_SALT_KEY=super_secret_por_hmac_salt_for_bar_masking
POR_SIGNING_PRIVATE_KEY_PEM="-----BEGIN EC PRIVATE KEY-----\nMHcCAQEEI...\n-----END EC PRIVATE KEY-----"
POR_PUBLIC_KEY_PEM="-----BEGIN PUBLIC KEY-----\nMFkwEwYHKoZIzj0CAQYIKoZIzj0DAQcDQgAE...\n-----END PUBLIC KEY-----"

# Cloudflare R2 / AWS S3 Storage for Public PoR
S3_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
S3_BUCKET_NAME=unykorn-proof-of-reserves
S3_ACCESS_KEY_ID=your_r2_access_key
S3_SECRET_ACCESS_KEY=your_r2_secret_key
S3_PUBLIC_BASE_URL=https://por.unykorn.ai

# Invariant & Circuit Breaker Limits
INVARIANT_BUFFER_MG=0
MAX_PER_TX_MINT_MG=1000000
